NODE_ENV=
PORT=
DATABASE_URL=postgres://family_os:family_os@localhost:5432/family_os
HEALTH_API_REPOSITORY=postgres
HEALTH_API_SYNC_LOCAL_AUTH_USERS=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
HEALTH_API_ENABLE_DEV_AUTH=
HEALTH_API_DEV_AUTH_USER_ID=
HEALTH_API_CORS_ORIGIN=*
HEALTH_API_RATE_LIMIT_WINDOW_MS=60000
HEALTH_API_RATE_LIMIT_MAX_WRITES=120
HEALTH_API_RATE_LIMIT_MAX_BUCKETS=10000
# Public MCP surface: origin + path → resource https://origin/health/api/mcp
# MCP_PUBLIC_ORIGIN is scheme+host only (no path/query/fragment).
# Metadata: https://origin/.well-known/oauth-protected-resource/health/api/mcp
# Consent:  https://origin/health/api/oauth/consent
MCP_PUBLIC_ORIGIN=https://familyos.deepanshujain.me
MCP_PUBLIC_PATH=/health/api/mcp
# Optional. Empty = any consented OAuth client (DCR-friendly for Grok/ChatGPT).
MCP_ALLOWED_OAUTH_CLIENT_IDS=
MCP_RESOURCE_NAME=Family OS Health MCP
MCP_CONSENT_VERSION=2026-07-18
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX_CALLS=60
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY_PATH=
FAMILY_OS_SECRETS_DIR=
