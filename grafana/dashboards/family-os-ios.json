{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Launches (24h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(app_ios_launches_total{installation_id=~\"$installation_id\"}[24h])) or vector(0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "title": "HealthKit sync groups (24h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(app_ios_healthkit_sync_completed_total{installation_id=~\"$installation_id\"}[24h])) or vector(0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "title": "HealthKit sync failures (24h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(app_ios_healthkit_sync_failures_total{installation_id=~\"$installation_id\"}[24h])) or vector(0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }
    },
    {
      "title": "Background wakes (24h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(app_ios_bg_tasks_total{installation_id=~\"$installation_id\"}[24h])) or vector(0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "title": "HealthKit sync active / wall duration",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(app_ios_healthkit_sync_duration_seconds_bucket{installation_id=~\"$installation_id\"}[24h])))", "legendFormat": "active p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(app_ios_healthkit_sync_duration_seconds_bucket{installation_id=~\"$installation_id\"}[24h])))", "legendFormat": "active p95", "refId": "B" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(app_ios_healthkit_sync_wall_seconds_bucket{installation_id=~\"$installation_id\"}[24h])))", "legendFormat": "wall p95", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "title": "Sync events (cumulative) by trigger",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (reason, outcome) (app_ios_healthkit_sync_runs_total{installation_id=~\"$installation_id\"})", "legendFormat": "{{reason}} {{outcome}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "pointSize": 4, "showPoints": "always", "spanNulls": true }, "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "title": "Sync failures (cumulative) by group",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (group, reason) (app_ios_healthkit_sync_failures_total{installation_id=~\"$installation_id\"})", "legendFormat": "{{group}} · {{reason}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "pointSize": 4, "showPoints": "always", "spanNulls": true }, "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "title": "Bootstrap (cumulative) events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (outcome) (app_ios_bootstrap_requests_total{installation_id=~\"$installation_id\"})", "legendFormat": "{{outcome}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "pointSize": 4, "showPoints": "always", "spanNulls": true }, "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "title": "HealthKit skips (cumulative) by reason",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (skip_reason) (app_ios_healthkit_sync_skips_total{installation_id=~\"$installation_id\"})", "legendFormat": "{{skip_reason}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "pointSize": 4, "showPoints": "always", "spanNulls": true }, "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "title": "Sign-in (cumulative) events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (outcome) (app_ios_auth_sign_in_total{installation_id=~\"$installation_id\"})", "legendFormat": "{{outcome}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "pointSize": 4, "showPoints": "always", "spanNulls": true }, "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "title": "Token refresh (cumulative) events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (source, outcome) (app_ios_auth_refresh_total{installation_id=~\"$installation_id\"})", "legendFormat": "{{source}} {{outcome}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "pointSize": 4, "showPoints": "always", "spanNulls": true }, "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "title": "Sign-out (cumulative) events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (reason) (app_ios_auth_sign_out_total{installation_id=~\"$installation_id\"})", "legendFormat": "{{reason}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "pointSize": 4, "showPoints": "always", "spanNulls": true }, "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "title": "Auth API 401 retries (cumulative)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (outcome) (app_ios_auth_api_retry_total{installation_id=~\"$installation_id\"})", "legendFormat": "{{outcome}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "pointSize": 4, "showPoints": "always", "spanNulls": true }, "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "title": "App identity",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (service_version, ios_build, deployment_environment, ios_build_configuration, device_id, installation_id) (app_ios_launches_total{installation_id=~\"$installation_id\"})",
        "format": "table",
        "instant": true,
        "refId": "A"
      }]
    },
    {
      "title": "Suspended background sync runs (24h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(app_ios_healthkit_sync_duration_seconds_count{installation_id=~\"$installation_id\",was_suspended=\"true\"}[24h])) or vector(0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } }, "overrides": [] }
    },
    {
      "title": "Background terminal events",
      "type": "logs",
      "gridPos": { "h": 16, "w": 18, "x": 6, "y": 58 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "{service_name=\"family-os-ios\"} |~ \"healthkit_(bg_sync_skip|bg_metric_failed|observer_sync_timeout|run_abandoned)\"",
        "refId": "A"
      }],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "title": "Background skips and failures (24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 74 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (skip_reason) (increase(app_ios_healthkit_sync_skips_total{installation_id=~\"$installation_id\"}[24h]))",
          "legendFormat": "skip · {{skip_reason}}",
          "refId": "A"
        },
        {
          "expr": "sum by (group, code) (increase(app_ios_healthkit_sync_failures_total{installation_id=~\"$installation_id\"}[24h]))",
          "legendFormat": "failure · {{group}} · {{code}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "title": "Per-group active / wall p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 74 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (group, le) (rate(app_ios_healthkit_metric_duration_seconds_bucket{installation_id=~\"$installation_id\"}[24h])))",
          "legendFormat": "{{group}} active",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (group, le) (rate(app_ios_healthkit_metric_wall_seconds_bucket{installation_id=~\"$installation_id\"}[24h])))",
          "legendFormat": "{{group}} wall",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ],
  "schemaVersion": 39,
  "tags": ["family-os", "ios", "metrics"],
  "description": "Event lines are cumulative counters. A flat line means no new event; a downward reset indicates an app-process restart. Use the Installation filter to isolate one device.",
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(app_ios_launches_total, installation_id)",
        "includeAll": true,
        "label": "Installation",
        "name": "installation_id",
        "options": [],
        "query": "label_values(app_ios_launches_total, installation_id)",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Family OS iOS",
  "uid": "family-os-ios",
  "version": 3
}
