<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Download the real GoogleService-Info.plist from Firebase Console:
  Project settings → Your apps → iOS app (com.deepanshujain.familyos) → Download GoogleService-Info.plist

  Place it next to this file as:
    apps/ios/FamilyOS/Resources/GoogleService-Info.plist

  Then add the file to the FamilyOS Xcode target (Copy Bundle Resources) if Xcode
  does not pick it up automatically. The committed example is not used at runtime.
-->
<plist version="1.0">
<dict>
	<key>CLIENT_ID</key>
	<string>REPLACE_ME.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.REPLACE_ME</string>
	<key>API_KEY</key>
	<string>REPLACE_ME</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE_ME</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.deepanshujain.familyos</string>
	<key>PROJECT_ID</key>
	<string>REPLACE_ME</string>
	<key>STORAGE_BUCKET</key>
	<string>REPLACE_ME.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:REPLACE_ME:ios:REPLACE_ME</string>
</dict>
</plist>
